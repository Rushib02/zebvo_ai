# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your_super_secret_key_here

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ai_creator_studio

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES=86400

# AI APIs
